# Supabase project credentials — Dashboard → Project Settings → API.
# Copy this file to .env.local and fill in both values, then restart dev.
# Leave unset to run xatu fully local (no accounts; browser storage only).
#
# The anon key is safe to expose to browsers: it only grants what Row Level
# Security allows. Never put the service-role key in any NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
